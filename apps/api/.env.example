# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/canva_clone?schema=public"

# API
API_PORT=3001
API_HOST=localhost

# CORS
CORS_ORIGIN=http://localhost:5173

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Upload limits
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Node
NODE_ENV=development
