# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/canva_clone?schema=public"

# API
API_PORT=3001
API_HOST=localhost

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
# For S3 (optional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload limits
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Node
NODE_ENV=development
